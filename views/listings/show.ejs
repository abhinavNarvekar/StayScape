<% layout("/layouts/boilerplate") %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>
<script>
  const bookings = <%- JSON.stringify(bookings) %>;
</script>

<div class="container" style="padding-top: 24px; padding-bottom: 48px;">

  <div class="row">

    <!-- HEADER -->
    <div class="col-12 col-md-8 offset-md-2">
      <div class="show-page-header">
        <h3><%= listing.title %></h3>
        <div class="show-location-text">
          <i class="fa-solid fa-location-dot"></i>
          <%= listing.location %>, <%= listing.country %>
        </div>
      </div>
    </div>

    <!-- IMAGE -->
    <div class="col-12 col-md-8 offset-md-2">
      <img
        src="<%= listing.image.url %>"
        class="show-img"
        alt="<%= listing.title %>"
      >
    </div>

    <!-- DETAILS -->
    <div class="col-12 col-md-8 offset-md-2">
      <div class="show-owner">
        Hosted by <strong><%= listing.owner.username %></strong>
      </div>

      <div class="show-description">
        <%= listing.description %>
      </div>

      <div class="show-price">
        ₹<%= listing.price.toLocaleString("en-IN") %> <span class="price-unit">/ night</span>
      </div>
    </div>

    <!-- EDIT + DELETE -->
    <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
    <div class="col-12 col-md-8 offset-md-2">
      <div class="show-actions">
        <a class="btn-edit" href="/listings/<%= listing._id %>/edit">
          <i class="fa-regular fa-pen-to-square"></i>
          Edit Listing
        </a>

        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="flex: 1; display: flex;">
          <button class="btn-delete" style="flex: 1;">
            <i class="fa-regular fa-trash-can" style="margin-right: 6px;"></i>
            Delete
          </button>
        </form>
      </div>
    </div>
    <% } %>

    <!-- BOOKING SECTION -->
    <% if(currUser){ %>
    <div class="col-12 col-md-8 offset-md-2" style="margin-top: 16px;">
      <div class="booking-card card">
        <h4>Book this stay</h4>

        <form action="/listings/<%= listing._id %>/book" method="POST">
          <!-- DATE RANGE PICKER -->
          <div class="mb-3">
            <label>Select Dates</label>
            <input type="text" id="dateRange" class="form-control" required placeholder="Check-in — Check-out">
          </div>

          <!-- HIDDEN INPUTS (sent to backend) -->
          <input type="hidden" name="checkIn" id="checkIn">
          <input type="hidden" name="checkOut" id="checkOut">

          <!-- PRICE -->
          <p id="pricePreview">
            Select dates to see total price
          </p>

          <!-- BUTTON -->
          <button class="btn btn-book" id="bookBtn" disabled>
            Reserve
          </button>
        </form>
      </div>
    </div>
    <% } %>

    <!-- REVIEW FORM -->
    <% if(currUser){ %>
    <div class="col-12 col-md-8 offset-md-2">
      <div class="review-form-section">
        <h4>Leave a Review</h4>

        <form action="/listings/<%= listing._id %>/reviews"
              method="POST"
              novalidate
              class="needs-validation">

          <fieldset class="starability-slot">
            <legend>Rating</legend>

            <input type="radio" id="rate1" name="review[rating]" value="1">
            <label for="rate1">1 star</label>

            <input type="radio" id="rate2" name="review[rating]" value="2">
            <label for="rate2">2 stars</label>

            <input type="radio" id="rate3" name="review[rating]" value="3">
            <label for="rate3">3 stars</label>

            <input type="radio" id="rate4" name="review[rating]" value="4">
            <label for="rate4">4 stars</label>

            <input type="radio" id="rate5" name="review[rating]" value="5">
            <label for="rate5">5 stars</label>
          </fieldset>

          <div class="mb-3 mt-3">
            <textarea class="form-control"
                      required
                      name="review[comment]"
                      rows="4"
                      placeholder="Share your experience..."></textarea>
          </div>

          <button class="btn btn-submit-review">
            Submit Review
          </button>
        </form>
      </div>
    </div>
    <% } %>

    <!-- REVIEWS -->
    <div class="col-12 col-md-8 offset-md-2">
      <div class="reviews-section">
        <h4>
          Reviews
          <% if(listing.reviews.length > 0) { %>
            <span class="review-count">(<%= listing.reviews.length %>)</span>
          <% } %>
        </h4>

        <% if(listing.reviews.length === 0) { %>
          <p style="color: #717171; font-size: 14px;">No reviews yet. Be the first to share your experience.</p>
        <% } %>

        <% for (let review of listing.reviews) { %>
        <div class="review-card">
          <div class="review-author">
            <div class="author-avatar"><%= review.author.username.charAt(0).toUpperCase() %></div>
            <span>@<%= review.author.username %></span>
          </div>

          <p class="starability-result" data-rating="<%= review.rating %>"></p>

          <p class="review-comment"><%= review.comment %></p>
        </div>
        <% } %>
      </div>
    </div>

    <!-- MAP -->
    <div class="col-12 col-md-8 offset-md-2">
      <div class="map-section">
        <h3>Where you'll be</h3>
        <div id="map"></div>
      </div>
    </div>

  </div>
</div>

<script src="/js/map.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {

  const pricePerNight = <%= listing.price %>;
  const bookings = <%- JSON.stringify(bookings) %>;

  const pricePreview = document.getElementById("pricePreview");
  const bookBtn = document.getElementById("bookBtn");

  const checkInInput = document.getElementById("checkIn");
  const checkOutInput = document.getElementById("checkOut");

  // disable booked ranges
  const disabledDates = bookings.map(b => ({
    from: b.checkIn,
    to: b.checkOut
  }));

  flatpickr("#dateRange", {
    mode: "range",
    minDate: "today",
    dateFormat: "Y-m-d",
    disable: disabledDates,

    onChange: function(selectedDates) {
      if (selectedDates.length === 2) {

        const checkInDate = selectedDates[0];
        const checkOutDate = selectedDates[1];

        // set hidden inputs
        checkInInput.value = checkInDate.toISOString().split("T")[0];
        checkOutInput.value = checkOutDate.toISOString().split("T")[0];

        // calculate nights
        const nights = (checkOutDate - checkInDate) / (1000 * 60 * 60 * 24);

        if (nights > 0) {
          const total = nights * pricePerNight;

          pricePreview.innerText =
            `₹${pricePerNight.toLocaleString("en-IN")} × ${nights} night${nights > 1 ? 's' : ''} = ₹${total.toLocaleString("en-IN")}`;

          bookBtn.disabled = false;
        } else {
          pricePreview.innerText = "Invalid dates";
          bookBtn.disabled = true;
        }

      } else {
        bookBtn.disabled = true;
      }
    }
  });

});
</script>

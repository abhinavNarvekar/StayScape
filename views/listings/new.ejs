<% layout("/layouts/boilerplate") %>

<div class="form-page">
  <h3>Create a new listing</h3>
  <p class="form-subtitle">Share your space with travelers around the world.</p>

  <form action="/listings" method="POST" class="needs-validation" novalidate enctype="multipart/form-data">

    <!-- Title -->
    <div class="mb-3">
      <label for="title" class="form-label">Title</label>
      <input name="listing[title]" type="text" placeholder="Give your place a catchy title" class="form-control" required>
      <div class="valid-feedback">Title looks good!</div>
    </div>

    <!-- Description -->
    <div class="mb-3">
      <label for="description" class="form-label">Description</label>
      <textarea name="listing[description]" placeholder="Describe what makes your place special" class="form-control" required rows="4"></textarea>
      <div class="invalid-feedback">Please enter a description.</div>
    </div>

    <!-- Image Upload -->
    <div class="mb-3">
      <label for="image" class="form-label">Listing Image</label>
      <input name="listing[image]" type="file" class="form-control">
    </div>

    <!-- Category -->
    <div class="mb-3">
      <label class="form-label">Category</label>
      <select name="listing[category]" class="form-select" required>
        <option value="" disabled selected hidden>Choose a category</option>
        <option value="rooms">Rooms</option>
        <option value="iconic">Iconic Cities</option>
        <option value="mountains">Mountains</option>
        <option value="castles">Castles</option>
        <option value="pools">Amazing Pools</option>
        <option value="camping">Camping</option>
        <option value="farms">Farms</option>
        <option value="arctic">Arctic</option>
        <option value="domes">Domes</option>
        <option value="boats">Boats</option>
      </select>
      <div class="invalid-feedback">Please select a category.</div>
    </div>

    <hr class="form-divider">

    <!-- Price + Country -->
    <div class="row">
      <div class="mb-3 col-md-4">
        <label for="price" class="form-label">Price per night (₹)</label>
        <input name="listing[price]" type="number" placeholder="e.g. 2500" class="form-control" required>
        <div class="invalid-feedback">Please enter a valid price.</div>
      </div>

      <div class="mb-3 col-md-8">
        <label for="country" class="form-label">Country</label>
        <input name="listing[country]" type="text" placeholder="e.g. India" class="form-control" required>
        <div class="invalid-feedback">Please enter a country name.</div>
      </div>
    </div>

    <!-- Location -->
    <div class="mb-3">
      <label for="location" class="form-label">Location</label>
      <input name="listing[location]" type="text" placeholder="e.g. Goa, Manali, Paris" class="form-control">
      <div class="invalid-feedback">Please enter a valid location.</div>
    </div>

    <button class="add-btn btn" type="submit">Publish Listing</button>

  </form>
</div>

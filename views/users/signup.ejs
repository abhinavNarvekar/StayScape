<% layout("/layouts/boilerplate") %>

<div class="auth-page">
  <div class="auth-card">
    <h3>Create your account</h3>
    <p class="auth-subtitle">Join StayScape and start exploring</p>

    <form action="/signup" method="POST" class="needs-validation" novalidate>

      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input id="username" name="username" type="text" class="form-control" placeholder="Choose a username" required>
        <div class="valid-feedback">Looks good!</div>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input id="email" name="email" type="email" class="form-control" placeholder="you@example.com" required>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input id="password" name="password" type="password" class="form-control" placeholder="Create a password" required>
      </div>

      <button type="submit" class="btn btn-auth">Sign Up</button>

    </form>

    <div class="auth-footer">
      Already have an account? <a href="/login">Log in</a>
    </div>
  </div>
</div>
